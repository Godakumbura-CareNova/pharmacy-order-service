{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "JwtSettings": {
    "Secret": "",
    "Issuer": "CareNova.UserAuth",
    "Audience": "CareNova.Client",
    "ExpiryInMinutes": 60
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "carenova-pharmacy-notifications",
    "LowStockThreshold": 10,
    "PublishRetryLimit": 3
  },

  "FileStorage": {
    "UploadPath": "wwwroot/uploads/medicines",
    "MaxFileSizeMb": 5,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ]
  },

  "PrescriptionStorage": {
    "UploadPath": "uploads/prescriptions",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
