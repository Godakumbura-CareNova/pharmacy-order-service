      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Browse medicines">
          <stringProp name="HTTPSampler.domain">${__P(server,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,5134)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
          <stringProp name="HTTPSampler.path">/api/catalogue/medicines?page=1&amp;pageSize=12</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments" />
          </elementProp>
          <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Assertion">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">
            </stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Validate JSON response" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename" />
            <stringProp name="parameters" />
            <stringProp name="script">import groovy.json.JsonSlurper
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    def path = prev.getURL().getPath()
    if (path.endsWith('/categories')) {
        assert body instanceof List : 'Categories must be a JSON array'
        assert !body.isEmpty() : 'Expected seeded categories'
        assert body.every { it instanceof Map &amp;&amp; it.id instanceof Number &amp;&amp; it.name instanceof String } : 'Invalid category fields'
    } else {
        assert body instanceof Map &amp;&amp; body.items instanceof List : 'Expected catalogue object with items array'
        assert body.page == 1 &amp;&amp; body.pageSize == 12 : 'Incorrect pagination'
        assert body.totalCount instanceof Number &amp;&amp; body.totalCount &gt;= body.items.size() : 'Invalid totalCount'
        assert !body.items.isEmpty() : 'Expected seeded medicines'
        assert body.items.every { it instanceof Map &amp;&amp; it.id instanceof Number &amp;&amp; it.name instanceof String &amp;&amp; it.price instanceof Number &amp;&amp; it.price &gt;= 0 } : 'Invalid medicine fields'
        if (prev.getURL().getQuery()?.contains('search=')) {
            def expected = java.net.URLDecoder.decode(props.getProperty('searchEncoded', 'Med1'), 'UTF-8').toLowerCase(java.util.Locale.ROOT)
            assert body.items.every { it.name.toLowerCase(java.util.Locale.ROOT).contains(expected) } : 'Search returned a nonmatching name'

        }
    }
} catch (Exception | AssertionError problem) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('JSON validation failed: ' + problem.getMessage())
}</stringProp>
          </JSR223Assertion>
          <hashTree />
        </hashTree>
