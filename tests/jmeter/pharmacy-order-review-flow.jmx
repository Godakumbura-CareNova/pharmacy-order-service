        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="10 STAFF GET /api/staff/orders (order left the queue)" enabled="true">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
